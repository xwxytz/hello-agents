
# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# API密钥
LLM_API_KEY=your_llm_api_key_here



# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# 高德地图API配置
AMAP_API_KEY="your_amap_api_key_here"

# 鉴权与限流（留空 = 鉴权关闭，本地开发照常可用）
# 注意：前端直连后端时不要开鉴权，Key 会暴露在浏览器里
# API_KEYS=
# AUTH_REQUIRED=false
# TRUST_PROXY=false
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PLAN_PER_MIN=10
# RATE_LIMIT_DEFAULT_PER_MIN=60

# 行程持久化（默认 SQLite 单文件；换 PostgreSQL 只改这一行）
# TRIP_DB_URL=sqlite:///./data/trips.db
# SHARE_PUBLIC_READ=true